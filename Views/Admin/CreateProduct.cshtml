@model Project.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<h1 class="text-3xl font-bold text-gray-900 mb-6">Create Product</h1>

<form asp-action="CreateProduct" method="post" enctype="multipart/form-data" class="max-w-xl">
    <div class="mb-4">
        <label asp-for="Name" class="block text-sm font-medium text-gray-700"></label>
        <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        <span asp-validation-for="Name" class="text-sm text-red-600"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Description" class="block text-sm font-medium text-gray-700"></label>
        <textarea asp-for="Description" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm"></textarea>
        <span asp-validation-for="Description" class="text-sm text-red-600"></span>
    </div>

    <div class="mb-4 grid grid-cols-2 gap-4">
        <div>
            <label asp-for="Price" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Price" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
            <span asp-validation-for="Price" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="StockQuantity" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="StockQuantity" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
            <span asp-validation-for="StockQuantity" class="text-sm text-red-600"></span>
        </div>
    </div>

    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Category</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm"></select>
    </div>

    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700">Image</label>
        <input type="file" name="imageFile" class="mt-1 block w-full" />
        <span class="text-sm text-gray-500">Or provide an external image URL:</span>
        <input asp-for="ImageUrl" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
        <span asp-validation-for="ImageUrl" class="text-sm text-red-600"></span>
    </div>

    <div class="mb-4">
        <label class="inline-flex items-center">
            <input asp-for="IsActive" type="checkbox" class="form-checkbox" />
            <span class="ml-2 text-sm text-gray-700">Is Active</span>
        </label>
    </div>

    <div class="flex gap-3">
        <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Create</button>
        <a asp-action="Index" class="rounded-md border px-4 py-2 text-sm">Cancel</a>
    </div>
</form>
