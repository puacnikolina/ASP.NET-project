@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="px-4 sm:px-6 lg:px-8 py-8 max-w-7xl mx-auto">
    <div class="mb-8">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">Account Settings</h2>
        <p class="mt-2 text-sm text-gray-500">Manage your profile, email, authentication settings, and personal data.</p>
    </div>

    <div class="lg:grid lg:grid-cols-4 lg:gap-x-8">
        <aside class="mb-8 lg:col-span-1 lg:mb-0">
            <nav class="space-y-1 sm:w-64">
                <partial name="_ManageNav" />
            </nav>
        </aside>

        <div class="lg:col-span-3">
            <div class="bg-white shadow sm:rounded-lg">
                <div class="px-4 py-5 sm:p-6 min-h-[400px]">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
