@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

    // Helper function to figure out the active class styling for Tailwind
    string GetActiveStyle(string? navClass)
    {
        if (navClass == "active")
        {
            return "bg-gray-50 text-indigo-600 group flex items-center px-3 py-2 text-sm font-medium rounded-md"; // Active State
        }
        return "text-gray-900 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-3 py-2 text-sm font-medium rounded-md"; // Inactive State
    }
}
<ul role="list" class="space-y-1">
    <li><a class="@GetActiveStyle(ManageNavPages.IndexNavClass(ViewContext))" id="profile" asp-page="./Index">Profile</a></li>
    <li><a class="@GetActiveStyle(ManageNavPages.EmailNavClass(ViewContext))" id="email" asp-page="./Email">Email</a></li>
    <li><a class="@GetActiveStyle(ManageNavPages.ChangePasswordNavClass(ViewContext))" id="change-password" asp-page="./ChangePassword">Password</a></li>
    @if (hasExternalLogins)
    {
        <li><a id="external-login" class="@GetActiveStyle(ManageNavPages.ExternalLoginsNavClass(ViewContext))" asp-page="./ExternalLogins">External logins</a></li>
    }
    <li><a class="@GetActiveStyle(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext))" id="two-factor" asp-page="./TwoFactorAuthentication">Two-factor authentication</a></li>
    <li><a class="@GetActiveStyle(ManageNavPages.PersonalDataNavClass(ViewContext))" id="personal-data" asp-page="./PersonalData">Personal data</a></li>
</ul>
